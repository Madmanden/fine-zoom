{
  "manifest_version": 3,
  "name": "Fine Zoom",
  "version": "1.0.0",
  "description": "Precise browser zoom \u2014 set any zoom level instead of snapping to preset steps. Control via popup, keyboard, and scroll wheel.",
  "homepage_url": "https://github.com/Madmanden/fine-zoom",
  "permissions": [
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-32.png",
      "128": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared/constants.js",
        "shared/utils.js",
        "content/zoom-methods.js",
        "content/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "zoom-in": {
      "suggested_key": {
        "default": "Ctrl+Shift+Up",
        "mac": "Command+Shift+Up"
      },
      "description": "Zoom text in"
    },
    "zoom-out": {
      "suggested_key": {
        "default": "Ctrl+Shift+Down",
        "mac": "Command+Shift+Down"
      },
      "description": "Zoom text out"
    },
    "zoom-reset": {
      "suggested_key": {
        "default": "Ctrl+Shift+0",
        "mac": "Command+Shift+0"
      },
      "description": "Reset text zoom"
    }
  },
  "options_page": "settings/settings.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-32.png",
    "128": "icons/icon-32.png"
  }
}
