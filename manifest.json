{
  "manifest_version": 3,
  "name": "Text Zoom",
  "version": "1.0.0",
  "description": "Control text zoom level with precision - no more jumpy fonts or broken layouts",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared/constants.js", "content/zoom-methods.js", "content/content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "zoom-in": {
      "suggested_key": {
        "default": "Ctrl+Shift+Equal",
        "mac": "Command+Shift+Equal"
      },
      "description": "Zoom text in"
    },
    "zoom-out": {
      "suggested_key": {
        "default": "Ctrl+Shift+Minus",
        "mac": "Command+Shift+Minus"
      },
      "description": "Zoom text out"
    },
    "zoom-reset": {
      "suggested_key": {
        "default": "Ctrl+Shift+0",
        "mac": "Command+Shift+0"
      },
      "description": "Reset text zoom"
    }
  },
  "options_page": "settings/settings.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}